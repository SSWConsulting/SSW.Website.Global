{
  "name": "astro-starter",
  "type": "module",
  "version": "0.0.1",
  "packageManager": "pnpm@10.28.2",
  "scripts": {
    "dev": "tinacms dev -c \"astro dev\"",
    "build": "cross-env NODE_OPTIONS=--max-old-space-size=4096 tinacms build --content=local --skip-cloud-checks -c \"astro build\"",
    "build:local": "tinacms build --local --skip-cloud-checks -c \"astro build\"",
    "build:search": "tinacms search-index",
    "preview": "astro preview",
    "preview:cf": "wrangler dev",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^13.1.10",
    "@astrojs/mdx": "^4.3.0",
    "@astrojs/rss": "^4.0.15",
    "@astrojs/sitemap": "^3.7.0",
    "@tinacms/astro": "0.0.0-c724883-20260514062230",
    "astro": "^6.1.10"
  },
  "devDependencies": {
    "@tinacms/cli": "2.1.8",
    "@types/node": "^25.1.0",
    "cross-env": "^7.0.3",
    "tinacms": "3.1.1",
    "wrangler": "4.59.2"
  },
  "pnpm": {
    "overrides": {
      "react": "18.3.1",
      "react-dom": "18.3.1"
    },
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "core-js",
      "esbuild",
      "protobufjs",
      "sharp",
      "workerd"
    ]
  }
}
