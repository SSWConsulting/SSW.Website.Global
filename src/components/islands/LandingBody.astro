---
import { tinaField } from '@tinacms/astro/tina-field';
import type { LandingQuery } from '../../../tina/__generated__/types';
import LandingNav from '../landing/LandingNav.astro';
import LandingFooter from '../landing/LandingFooter.astro';

interface Props {
  data?: LandingQuery['landing'] | null;
}

const { data } = Astro.props;
if (!data) return null;

const nav = data.nav;
const hero = data.hero;

// Split a title on **accent** markers into alternating plain/accent segments.
const parseAccentTitle = (s: string | null | undefined) => {
  if (!s) return [] as Array<{ text: string; accent: boolean }>;
  return s.split(/\*\*([^*]+)\*\*/g).map((part, i) => ({ text: part, accent: i % 2 === 1 }));
};
const heroTitleParts = parseAccentTitle(hero?.title);

// Parse [label](url) inline markdown links into render-ready segments.
type InlinePart = { type: 'text'; value: string } | { type: 'link'; label: string; href: string };
const parseInlineLinks = (s: string | null | undefined): InlinePart[] => {
  if (!s) return [];
  const out: InlinePart[] = [];
  const re = /\[([^\]]+)\]\(([^)]+)\)/g;
  let last = 0;
  let m: RegExpExecArray | null;
  while ((m = re.exec(s)) !== null) {
    if (m.index > last) out.push({ type: 'text', value: s.slice(last, m.index) });
    out.push({ type: 'link', label: m[1], href: m[2] });
    last = m.index + m[0].length;
  }
  if (last < s.length) out.push({ type: 'text', value: s.slice(last) });
  return out;
};
// Split a stat number on the last space so editors can type 'up to 3' and the
// 'up to' renders smaller before the display-sized number. No-prefix values
// (e.g. '30', '99.4') return prefix='' and main is the original string.
const splitStatNumber = (s: string | null | undefined) => {
  const trimmed = (s ?? '').trim();
  const i = trimmed.lastIndexOf(' ');
  if (i === -1) return { prefix: '', main: trimmed };
  return { prefix: trimmed.slice(0, i).trim(), main: trimmed.slice(i + 1).trim() };
};
const stats = data.stats ?? [];
const benefits = data.benefitsSection;
const services = data.servicesSection;
const how = data.howSection;
const why = data.whySection;
const faq = data.faqSection;
const contact = data.contactSection;
const ctaBanner = data.ctaBanner;
const footer = data.footer;
---

<LandingNav nav={nav} />

<main id="top">

  {hero && (
    <section class="hero">
      {/* Ambient B&W coding-screen video, looped and muted. Lives at the
          section level (not inside .hero-frame) so it plays as a full-bleed
          background visible in the gutter around the framed panel. Autoplay
          needs muted+playsinline to pass mobile/Chrome policy. Source is
          pre-encoded to true grayscale at the pixel level — the CSS filter()
          rule remains defensively in case the file is later replaced with a
          colored source. preload="metadata" keeps first paint cheap;
          prefers-reduced-motion hides the video entirely.

          Hardcoded path rather than a Tina field — adding a field to the
          landing collection's hero block triggers the Tina Cloud schema-sync
          gotcha (deploy serves "Not Found" until the cloud schema catches
          up). Swap the src below to replace. */}
      <video
        class="hero-video"
        src="/assets/hero-bg.mp4"
        autoplay
        loop
        muted
        playsinline
        preload="metadata"
        aria-hidden="true"
        tabindex={-1}
      ></video>
      <div class="container">
        <div class="hero-frame">
          {hero.image && (
            <div
              class="hero-bg"
              role="img"
              aria-label={hero.imageAlt ?? ''}
              style={`--hero-image: url("${hero.image.replace(/"/g, '%22')}")`}
              data-tina-field={tinaField(hero, 'image')}
            ></div>
          )}

          {/* Decorative corner brackets — magazine/artboard framing chrome. */}
          <span class="hero-corner tl" aria-hidden="true"></span>
          <span class="hero-corner tr" aria-hidden="true"></span>
          <span class="hero-corner bl" aria-hidden="true"></span>
          <span class="hero-corner br" aria-hidden="true"></span>

          {/* Top technical metadata strip. The eyebrow + region are editable;
              the segmented bar marks and the "FRAME 12" tick are decorative. */}
          <div class="hero-strip hero-strip-top">
            <div class="strip-group">
              {hero.eyebrow && <span class="strip-label" data-tina-field={tinaField(hero, 'eyebrow')}>{hero.eyebrow}</span>}
            </div>
          </div>

          {/* Center — big tracked display title + lead + CTAs */}
          <div class="hero-center">
            <h1 class="hero-title reveal" style="--reveal-delay: 80ms" data-tina-field={tinaField(hero, 'title')}>
              {heroTitleParts.map((part) => (part.accent ? <em>{part.text}</em> : <Fragment>{part.text}</Fragment>))}
            </h1>
            {hero.lead && <p class="hero-lead reveal" style="--reveal-delay: 160ms" data-tina-field={tinaField(hero, 'lead')}>{hero.lead}</p>}
            <div class="hero-ctas reveal" style="--reveal-delay: 240ms">
              {hero.primaryCta && (
                <a href={hero.primaryCta.href ?? '#contact'} class="btn btn-primary btn-lg" data-tina-field={tinaField(hero.primaryCta, 'label')}>
                  {hero.primaryCta.icon && <i class={hero.primaryCta.icon}></i>} {hero.primaryCta.label}
                </a>
              )}
              {hero.secondaryCta && (
                <a href={hero.secondaryCta.href ?? '#how'} class="btn btn-secondary btn-lg" data-tina-field={tinaField(hero.secondaryCta, 'label')}>
                  {hero.secondaryCta.label} {hero.secondaryCta.icon && <i class={hero.secondaryCta.icon}></i>}
                </a>
              )}
            </div>
          </div>

          {/* Bottom technical metadata strip — editable spec tokens from
              hero.checks, with a decorative segmented bar mark at the end.
              Hidden entirely when no checks are configured so the hero frame
              doesn't reserve empty space at the bottom. */}
          {hero.checks && hero.checks.length > 0 && (
            <div class="hero-strip hero-strip-bottom">
              {hero.checks.map((c, i) => c && (
                <span class="strip-token">
                  <span class="tok-mark" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                  <span data-tina-field={tinaField(c, 'text')}>{c.text}</span>
                </span>
              ))}
            </div>
          )}
        </div>
      </div>
    </section>
  )}

  {stats.length > 0 && (
    <div class="stats">
      <div class="container">
        <div class="stats-grid">
          {stats.map((s, i) => s && (
            <div class="stat reveal" style={`--reveal-delay: ${i * 60}ms`}>
              <div class="num" data-tina-field={tinaField(s, 'number')}>
                {(() => {
                  const { prefix, main } = splitStatNumber(s.number);
                  return (
                    <>
                      {prefix && <span class="num-prefix">{prefix} </span>}
                      <span class="num-main">{main}</span>
                    </>
                  );
                })()}
                <em data-tina-field={tinaField(s, 'suffix')}>{s.suffix}</em>
              </div>
              {/* Stat label supports an optional second line via a literal
                  `\n` in the Tina string. First line renders as the primary
                  label; any additional lines fall to a muted subtitle
                  vocabulary (see .label-primary / .label-secondary in
                  landing.css). Single-line labels still render as one span
                  and inherit the primary style. */}
              <div class="label" data-tina-field={tinaField(s, 'label')}>
                {(s.label ?? '').split('\n').map((line, idx) => (
                  <span class={idx === 0 ? 'label-primary' : 'label-secondary'}>{line}</span>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  )}

  {benefits && (
    <section class="block">
      <div class="container">
        <div class="block-head reveal">
          {benefits.kicker && <div class="section-kicker" data-tina-field={tinaField(benefits, 'kicker')}>{benefits.kicker}</div>}
          {benefits.title && <h2 class="section-title" data-tina-field={tinaField(benefits, 'title')}>{benefits.title}</h2>}
          {benefits.lead && (
            <p class="lead" data-tina-field={tinaField(benefits, 'lead')}>
              {parseInlineLinks(benefits.lead).map((part) =>
                part.type === 'link'
                  ? <a href={part.href} target="_blank" rel="noopener noreferrer" class="content-link">{part.label}</a>
                  : <Fragment>{part.value}</Fragment>,
              )}
            </p>
          )}
        </div>
        {benefits.items && benefits.items.length > 0 && (
          <div class="benefits-grid">
            {benefits.items.map((b, i) => b && (
              <article class="benefit reveal" style={`--reveal-delay: ${i * 60}ms`}>
                <div class="icon"><i class={`fa-solid ${b.icon ?? ''}`}></i></div>
                <h3 data-tina-field={tinaField(b, 'title')}>{b.title}</h3>
                <p data-tina-field={tinaField(b, 'description')}>
                  {parseInlineLinks(b.description).map((part) =>
                    part.type === 'link'
                      ? <a href={part.href} target="_blank" rel="noopener noreferrer" class="content-link">{part.label}</a>
                      : <Fragment>{part.value}</Fragment>,
                  )}
                </p>
              </article>
            ))}
          </div>
        )}
      </div>
    </section>
  )}

  {services && (
    <section class="block sunken" id="services">
      <div class="container">
        <div class="block-head reveal">
          {services.kicker && <div class="section-kicker" data-tina-field={tinaField(services, 'kicker')}>{services.kicker}</div>}
          {services.title && <h2 class="section-title" data-tina-field={tinaField(services, 'title')}>{services.title}</h2>}
          {services.lead && <p class="lead" data-tina-field={tinaField(services, 'lead')}>{services.lead}</p>}
        </div>
        {services.items && services.items.length > 0 && (
          <div class="services-grid">
            {services.items.map((s, i) => s && (
              <article class="service reveal" style={`--reveal-delay: ${i * 60}ms`}>
                <div class="icon"><i class={`fa-solid ${s.icon ?? ''}`}></i></div>
                <div class="body">
                  <h3 data-tina-field={tinaField(s, 'title')}>{s.title}</h3>
                  <p data-tina-field={tinaField(s, 'description')}>
                    {parseInlineLinks(s.description).map((part) =>
                      part.type === 'link'
                        ? <a href={part.href} target="_blank" rel="noopener noreferrer" class="content-link">{part.label}</a>
                        : <Fragment>{part.value}</Fragment>,
                    )}
                  </p>
                </div>
              </article>
            ))}
          </div>
        )}

        {/* Mid-page CTA, sitting below the Capabilities cards inside the same
            sunken section. Copy is hardcoded rather than wired to a new Tina
            field on servicesSection — adding a field to the landing
            collection's hero/services blocks triggers the Tina Cloud
            schema-sync gotcha (deploy serves "Not Found" until cloud catches
            up). If marketing needs to edit this string later, the right path
            is a separate schema-add PR that gets deployed once and stays. */}
        <div class="section-cta reveal" style="--reveal-delay: 240ms">
          <h3 class="section-cta-title">Have a project in mind?</h3>
          <p class="section-cta-lead">Talk to a senior software consultant about what you're building, what's holding it back, and the smartest next step.</p>
          <a href="#contact" class="btn btn-primary btn-lg">
            <i class="fa-regular fa-message"></i> Book a free consultation
          </a>
        </div>
      </div>
    </section>
  )}

  {how && (
    <section class="block" id="how">
      <div class="container">
        <div class="block-head reveal">
          {how.kicker && <div class="section-kicker" data-tina-field={tinaField(how, 'kicker')}>{how.kicker}</div>}
          {how.title && <h2 class="section-title" data-tina-field={tinaField(how, 'title')}>{how.title}</h2>}
          {how.lead && <p class="lead" data-tina-field={tinaField(how, 'lead')}>{how.lead}</p>}
        </div>
        {how.steps && how.steps.length > 0 && (
          <div class="steps">
            {how.steps.map((s, i) => s && (
              <article class="step reveal" style={`--reveal-delay: ${i * 80}ms`}>
                <div class="step-num" data-tina-field={tinaField(s, 'stepLabel')}>{s.stepLabel}</div>
                <h3 data-tina-field={tinaField(s, 'title')}>{s.title}</h3>
                <p data-tina-field={tinaField(s, 'description')}>
                  {parseInlineLinks(s.description).map((part) =>
                    part.type === 'link'
                      ? <a href={part.href} target="_blank" rel="noopener noreferrer" class="content-link">{part.label}</a>
                      : <Fragment>{part.value}</Fragment>,
                  )}
                </p>
              </article>
            ))}
          </div>
        )}
      </div>
    </section>
  )}

  {why && (
    <section class="block sunken" id="why">
      <div class="container">
        <div class="block-head reveal">
          {why.kicker && <div class="section-kicker" data-tina-field={tinaField(why, 'kicker')}>{why.kicker}</div>}
          {why.title && <h2 class="section-title" data-tina-field={tinaField(why, 'title')}>{why.title}</h2>}
          {why.lead && <p class="lead" data-tina-field={tinaField(why, 'lead')}>{why.lead}</p>}
        </div>
        <div class="why-grid">
          {why.rows && why.rows.length > 0 && (
            <div class="why-list">
              {why.rows.map((r, i) => r && (
                <div class="why-row reveal" style={`--reveal-delay: ${i * 60}ms`}>
                  <div class="icon"><i class={`fa-solid ${r.icon ?? ''}`}></i></div>
                  <div>
                    {/* Title supports [label](url) inline markdown links — same
                        parser as the description below. Lets editors point a
                        single phrase in the headline at an SSW rules page (e.g.
                        "Proven [Scrum process](…)") without splitting into a
                        separate Tina field. */}
                    <h4 data-tina-field={tinaField(r, 'title')}>
                      {parseInlineLinks(r.title).map((part) =>
                        part.type === 'link'
                          ? <a href={part.href} target="_blank" rel="noopener noreferrer" class="content-link">{part.label}</a>
                          : <Fragment>{part.value}</Fragment>,
                      )}
                    </h4>
                    <p data-tina-field={tinaField(r, 'description')}>
                      {parseInlineLinks(r.description).map((part) =>
                        part.type === 'link'
                          ? <a href={part.href} target="_blank" rel="noopener noreferrer" class="content-link">{part.label}</a>
                          : <Fragment>{part.value}</Fragment>,
                      )}
                    </p>
                  </div>
                </div>
              ))}
            </div>
          )}

          {/* YouTube embed for the Why-SSW pitch video, occupying the right
              column of the why-grid. Sits in the same 2-col rhythm as the
              testimonial used to (now moved below as its own full-width row).
              URL is hardcoded for the same reason the hero video is — adding
              a Tina field on the why block hits the schema-sync gotcha. Swap
              the videoId below to replace.

              youtube-nocookie.com (privacy-enhanced mode) so YouTube doesn't
              drop cookies until the user hits play; loading="lazy" defers
              the iframe until it scrolls near the viewport. */}
          <div class="why-video reveal" style="--reveal-delay: 120ms">
            <iframe
              src="https://www.youtube-nocookie.com/embed/Jveq6VFjWTA"
              title="Why SSW"
              loading="lazy"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
              referrerpolicy="strict-origin-when-cross-origin"
              allowfullscreen
            ></iframe>
          </div>
        </div>

        {/* Testimonial carousel — three rotating cards under the why-grid.
            The first card is the Tina-editable why.testimonial (still
            wired up with data-tina-field bindings so editors can change
            the BizCover quote in-place). Cards 2 and 3 are hardcoded
            here because adding a `list: true` array to the testimonial
            field on the landing schema would trigger the Tina Cloud
            schema-sync gotcha — safer to inline the extras and accept
            that they're code-edits rather than CMS-edits. Auto-rotate
            and pause-on-hover are handled by the inline script at the
            bottom of this file. */}
        {why.testimonial && (() => {
          const extraTestimonials = [
            {
              quote: "We have dealt with several people at SSW from a network tech helping us with a domain issue, to a couple of graphic designers and several programmers and they have ALL been first rate.",
              avatarInitials: "PD",
              name: "Peter Dimaridis",
              role: "AuctionsPlus",
            },
            {
              quote: "SSW's expertise and professionalism in software development left a deep impression on me. They brought exceptional value to our dev team, inspiring them with their punctuality and diligence. I'm grateful for their unwavering commitment to excellence and delighted to have them in our office. Thank you, SSW!",
              avatarInitials: "YL",
              name: "Yun Lu",
              role: "LUQI Tech",
            },
          ];
          const testimonials = [why.testimonial, ...extraTestimonials];
          return (
            <div class="why-card-shell">
              <div
                class="why-carousel reveal"
                style="--reveal-delay: 0ms"
                data-rotate-interval="8000"
                aria-roledescription="carousel"
                aria-label="Client testimonials"
              >
                {testimonials.map((t, i) => (
                  <aside
                    class={`why-card${i === 0 ? ' is-active' : ''}`}
                    role="group"
                    aria-roledescription="slide"
                    aria-label={`Testimonial ${i + 1} of ${testimonials.length}`}
                    aria-hidden={i === 0 ? 'false' : 'true'}
                  >
                    {/* Closing quotation mark, decorative, anchored to the card's
                        top-right corner via CSS. aria-hidden so screen readers don't
                        announce a stray punctuation character. */}
                    <div class="quote-mark" aria-hidden="true">”</div>
                    <blockquote data-tina-field={i === 0 ? tinaField(why.testimonial, 'quote') : undefined}>
                      {/* Reuses parseAccentTitle (which already splits on **markers**)
                          to bold opener phrases in the quote. The marker maps to
                          <strong> here rather than <em> — emphasis on importance,
                          not typographic stress — and the CSS styles <strong>
                          brighter/white so the opener pops against the muted body. */}
                      {parseAccentTitle(t.quote).map((p) =>
                        p.accent ? <strong>{p.text}</strong> : <Fragment>{p.text}</Fragment>,
                      )}
                    </blockquote>
                    <div class="attr">
                      <div class="avatar" data-tina-field={i === 0 ? tinaField(why.testimonial, 'avatarInitials') : undefined}>{t.avatarInitials}</div>
                      <div>
                        <div class="name" data-tina-field={i === 0 ? tinaField(why.testimonial, 'name') : undefined}>{t.name}</div>
                        <div class="role" data-tina-field={i === 0 ? tinaField(why.testimonial, 'role') : undefined}>{t.role}</div>
                      </div>
                    </div>
                  </aside>
                ))}
                {/* Dot navigation — clicking a dot jumps to that slide and
                    resets the auto-rotate timer. Real <button> elements so
                    Tab navigation lands on them and Enter/Space activates. */}
                <div class="carousel-dots" role="tablist" aria-label="Choose testimonial">
                  {testimonials.map((_, i) => (
                    <button
                      type="button"
                      class={`dot${i === 0 ? ' is-active' : ''}`}
                      role="tab"
                      aria-selected={i === 0 ? 'true' : 'false'}
                      aria-label={`Show testimonial ${i + 1}`}
                      data-slide-index={i}
                    ></button>
                  ))}
                </div>
              </div>
            </div>
          );
        })()}
      </div>
    </section>
  )}

  {faq && (
    <section class="block" id="faq">
      <div class="container">
        <div class="faq-grid">
          <div class="faq-head reveal">
            {faq.kicker && <div class="section-kicker" data-tina-field={tinaField(faq, 'kicker')}>{faq.kicker}</div>}
            {faq.title && <h2 class="section-title" data-tina-field={tinaField(faq, 'title')}>{faq.title}</h2>}
            {faq.lead && <p class="lead" data-tina-field={tinaField(faq, 'lead')}>{faq.lead}</p>}
            {faq.helper && (
              <div class="faq-helper">
                {faq.helper.kicker && <div class="helper-kicker" data-tina-field={tinaField(faq.helper, 'kicker')}>{faq.helper.kicker}</div>}
                {faq.helper.title && <h3 data-tina-field={tinaField(faq.helper, 'title')}>{faq.helper.title}</h3>}
                {faq.helper.description && <p data-tina-field={tinaField(faq.helper, 'description')}>{faq.helper.description}</p>}
                {faq.helper.ctaLabel && (
                  <div class="helper-actions">
                    <a href={faq.helper.ctaHref ?? '#contact'} class="btn btn-primary" data-tina-field={tinaField(faq.helper, 'ctaLabel')}>
                      {faq.helper.ctaIcon && <i class={faq.helper.ctaIcon}></i>} {faq.helper.ctaLabel}
                    </a>
                  </div>
                )}
              </div>
            )}
          </div>

          {faq.items && faq.items.length > 0 && (
            <div class="faq-list">
              {faq.items.map((item, i) => item && (
                <details class="faq-item reveal" style={`--reveal-delay: ${i * 60}ms`} open={item.openByDefault ?? false}>
                  <summary>
                    <span data-tina-field={tinaField(item, 'question')}>{item.question}</span>
                    {/* Render both glyphs and let CSS show the right one based on
                        the parent <details>'s open state. Cleaner than rotating a
                        single + into an ×, which never quite reads as a minus. */}
                    <span class="toggle">
                      <i class="fa-solid fa-plus toggle-plus" aria-hidden="true"></i>
                      <i class="fa-solid fa-minus toggle-minus" aria-hidden="true"></i>
                    </span>
                  </summary>
                  <div class="answer">
                    {item.paragraphs?.map((p) => p && (
                      <p data-tina-field={tinaField(p, 'text')}>{p.text}</p>
                    ))}
                  </div>
                </details>
              ))}
            </div>
          )}
        </div>
      </div>
    </section>
  )}

  {contact && (
    <section class="block" id="contact">
      <div class="container">
        <div class="block-head reveal">
          {contact.kicker && <div class="section-kicker" data-tina-field={tinaField(contact, 'kicker')}>{contact.kicker}</div>}
          {contact.title && <h2 class="section-title" data-tina-field={tinaField(contact, 'title')}>{contact.title}</h2>}
          {contact.lead && <p class="lead" data-tina-field={tinaField(contact, 'lead')}>{contact.lead}</p>}
        </div>

        <div class="contact-grid">
          {/*
            Submits directly to Jotform. As shipped in HTML, this is a plain
            <form action="/api/contact" method=POST>: with JS off the browser
            does its own required-field validation and posts to our Astro API
            route, which proxies to Jotform server-side and 303-redirects back
            to /?contact=ok|err#contact. The inline script in
            src/pages/index.astro progressively enhances it by intercepting
            submit, POSTing JSON to the same endpoint via fetch(), and
            inspecting the JSON response — so the success UI only fires when
            Jotform actually accepted the payload, not when it returned a 400
            error page (which the old iframe-target flow could not detect).

            The form is only rendered when jotformId is present in the Tina
            content. Tina schema marks the field required so editors can't
            clear it, but if it ever IS missing (broken deploy, partial
            content, etc.) we render an email fallback instead of an
            action-less form that would silently post back to this page.

            The jotformId is sent as a hidden field so the proxy knows which
            Jotform form to target — keeps the secret-free form ID in Tina
            content rather than in a server-side env var.
          */}
          {contact.form?.jotformId ? (
            <>
              <form
                class="form-card reveal"
                id="contact-form"
                method="POST"
                action="/api/contact"
              >
              <input type="hidden" name="jotformId" value={contact.form.jotformId} />
            {contact.form && (
              <div class="form-header">
                {contact.form.title && <h3 data-tina-field={tinaField(contact.form, 'title')}>{contact.form.title}</h3>}
                {contact.form.description && <p data-tina-field={tinaField(contact.form, 'description')}>{contact.form.description}</p>}
              </div>
            )}
            {/* Adaptive-placeholder pattern per
                https://www.ssw.com.au/rules/use-adaptive-placeholders-on-your-forms
                — the <label> sits inside the field at rest (acting as the
                placeholder) and animates up + shrinks when the field is
                focused or has a value.

                Implementation notes for editors / future authors:
                - The <label> renders AFTER the input/select/textarea so the
                  CSS `~ label` sibling selector can target it.
                - Inputs and textareas use placeholder=" " (a single space)
                  so `:placeholder-shown` reliably reports the empty state;
                  the real label copy lives in the <label>, not the
                  placeholder attribute.
                - Selects use a `value="" disabled selected hidden` first
                  option as the placeholder slot; CSS detects the empty
                  state via :required:invalid (for required selects) or
                  :has(option[value=""]:checked) (for the optional Budget).
                  `hidden` keeps that empty option out of the open
                  dropdown list. */}
            <div class="form-row">
              <div class="field">
                <input id="f-name" name="name" type="text" required placeholder=" " autocomplete="name" />
                <label for="f-name">Full name <span class="req">*</span></label>
              </div>
              <div class="field">
                <input id="f-company" name="company" type="text" required placeholder=" " autocomplete="organization" />
                <label for="f-company">Company <span class="req">*</span></label>
              </div>
            </div>
            <div class="form-row">
              <div class="field">
                <input id="f-email" name="email" type="email" required placeholder=" " autocomplete="email" />
                <label for="f-email">Work email <span class="req">*</span></label>
              </div>
              <div class="field">
                <input
                  id="f-phone"
                  name="phone"
                  type="tel"
                  inputmode="tel"
                  autocomplete="tel-national"
                  required
                  placeholder=" "
                />
                <label for="f-phone">Phone (U.S. or Canada) <span class="req">*</span></label>
              </div>
            </div>
            <div class="form-row">
              <div class="field">
                <select id="f-country" name="country" required>
                  <option value="" disabled selected hidden></option>
                  <option>United States</option>
                  <option>Canada</option>
                  <option>Other</option>
                </select>
                <label for="f-country">Country <span class="req">*</span></label>
              </div>
              <div class="field">
                <select id="f-project" name="project_type" required>
                  <option value="" disabled selected hidden></option>
                  {services?.items?.map((s) => s && <option>{s.title}</option>)}
                  <option>Not sure yet</option>
                </select>
                <label for="f-project">Project type <span class="req">*</span></label>
              </div>
            </div>
            <div class="field">
              <select id="f-budget" name="budget">
                <option value="" selected hidden></option>
                <option>Under $50K</option>
                <option>$50K to $150K</option>
                <option>$150K to $500K</option>
                <option>$500K to $1M</option>
                <option>$1M and above</option>
                <option>Not sure yet</option>
              </select>
              <label for="f-budget">Estimated budget</label>
            </div>
            <div class="field">
              <textarea
                id="f-message"
                name="message"
                required
                placeholder=" "
              ></textarea>
              <label for="f-message">Tell us about your project <span class="req">*</span></label>
            </div>
            <input
              type="text"
              name="website"
              tabindex="-1"
              autocomplete="off"
              aria-hidden="true"
              style="position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0;opacity:0"
            />
            <div class="form-actions">
              {contact.form?.privacy && (
                <div class="privacy" data-tina-field={tinaField(contact.form, 'privacy')}>
                  {(() => {
                    const text = contact.form.privacy ?? '';
                    const linkLabel = contact.form.privacyLinkLabel ?? 'privacy policy';
                    const linkHref = contact.form.privacyLinkHref ?? '#';
                    const parts = text.split('{link}');
                    /* No whitespace between {parts[0]}, <a>, and {parts[1]}
                       — JSX/Astro inserts a space character between sibling
                       expressions on separate lines, which would render as
                       "...our privacy policy . We never..." with a visible
                       space before the full stop. */
                    return (<>{parts[0]}<a href={linkHref} class="content-link">{linkLabel}</a>{parts[1] ?? ''}</>);
                  })()}
                </div>
              )}
              {contact.form?.submitLabel && (
                <button type="submit" class="btn btn-primary btn-lg" data-tina-field={tinaField(contact.form, 'submitLabel')}>
                  {contact.form.submitIcon && <i class={contact.form.submitIcon}></i>} {contact.form.submitLabel}
                </button>
              )}
            </div>
            {contact.form?.successText && (
              <div class="form-success" id="form-success">
                <i class="fa-solid fa-circle-check" style="font-size:18px;"></i>
                <div data-tina-field={tinaField(contact.form, 'successText')}>{contact.form.successText}</div>
              </div>
            )}
            <div class="form-error" id="form-error" role="alert" aria-live="polite" hidden>
              <i class="fa-solid fa-circle-exclamation" style="font-size:18px;" aria-hidden="true"></i>
              <div>
                {/* `form-error-message` is replaced by the submit script with
                    a server-supplied error when the API proxy reports a
                    validation failure (e.g. "Missing required fields: phone",
                    "Invalid email address"). Falls back to "Something went
                    wrong." for network/timeout failures where we have no
                    specific message. */}
                <span id="form-error-message">Something went wrong.</span>
                {' '}Please try again or email <a href="mailto:hello@ssw.com">hello@ssw.com</a>.
              </div>
            </div>
          </form>
            </>
          ) : (
            <div class="form-card form-card-fallback reveal" role="alert">
              <div class="form-header">
                <h3>Contact form unavailable</h3>
                <p>The form is temporarily offline. Please email <a href="mailto:hello@ssw.com">hello@ssw.com</a> and a senior consultant will get back to you within one business day.</p>
              </div>
            </div>
          )}

          {/* Right-column aside (Americas / hello@ssw.com cards) removed —
              duplicated info already covered by the nav region badge and
              the footer contact links. contact.asideItems data is left in
              place in the Tina schema so the field stays editable, but
              no longer renders. */}
        </div>
      </div>
    </section>
  )}

  {ctaBanner && (
    <section class="cta-banner">
      <div class="container">
        {ctaBanner.title && <h2 class="reveal" style="--reveal-delay: 0ms" data-tina-field={tinaField(ctaBanner, 'title')}>{ctaBanner.title}</h2>}
        {ctaBanner.description && <p class="reveal" style="--reveal-delay: 80ms" data-tina-field={tinaField(ctaBanner, 'description')}>{ctaBanner.description}</p>}
        {ctaBanner.ctaLabel && (
          <div class="reveal" style="--reveal-delay: 160ms; display:flex; gap:12px; justify-content:center; flex-wrap:wrap;">
            <a href={ctaBanner.ctaHref ?? '#contact'} class="btn btn-primary btn-lg" data-tina-field={tinaField(ctaBanner, 'ctaLabel')}>
              {ctaBanner.ctaIcon && <i class={ctaBanner.ctaIcon}></i>} {ctaBanner.ctaLabel}
            </a>
          </div>
        )}
      </div>
    </section>
  )}
</main>

<LandingFooter footer={footer} reveal />
