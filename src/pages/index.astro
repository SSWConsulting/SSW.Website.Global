---
import '../styles/landing.css';
import { ClientRouter } from 'astro:transitions';
import TinaIsland from '@tinacms/astro/TinaIsland.astro';
import LandingBody from '../components/islands/LandingBody.astro';
import GoogleAnalytics from '../components/GoogleAnalytics.astro';
import { getLanding } from '../lib/data';
import { islands } from '../lib/islands';

const slug = 'home';
const result = await getLanding(slug);
const data = result.data?.landing;
if (!data) return new Response('Not Found', { status: 404 });
const meta = data.meta;
---

<!doctype html>
<html lang="en" class="dark">
<head>
  <GoogleAnalytics />
  {/* Mark JS as available before paint so `html.js .reveal` rules engage
      and no FOUC occurs. No-JS users skip the scroll-reveal motion entirely. */}
  <script is:inline>document.documentElement.classList.add('js');</script>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{meta?.title ?? 'SSW'}</title>
  <meta name="description" content={meta?.description ?? ''} />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
  <link rel="icon" type="image/png" href="/favicon-32x32.png" sizes="32x32" />
  <link rel="icon" type="image/png" href="/favicon-16x16.png" sizes="16x16" />
  <link rel="mask-icon" href="/safari-pinned-tab.svg" color="#cc4141" />
  <link rel="shortcut icon" href="/favicon.ico" />
  <link rel="stylesheet" href="/assets/colors_and_type.css" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" integrity="sha512-SnH5WK+bZxgPHs44uWIX+LLJAJ9/2PkPKZ5QiAj6Ta86w+fsb2TkcmfRyVX3pBnMFcV7oQPJkl9QevSCWr3W6A==" crossorigin="anonymous" referrerpolicy="no-referrer" />
  <ClientRouter />
</head>
<body>
  <TinaIsland name="landing" wrapper={islands.landing.wrapper} params={{ slug }} primary>
    <LandingBody data={data} />
  </TinaIsland>

  <script>
    const nav = document.getElementById('nav');
    const onScroll = () => { if (nav) (nav as HTMLElement).dataset.scrolled = window.scrollY > 12 ? 'true' : 'false'; };
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();

    // Scroll-reveal: every .reveal element fades up the first time it
    // crosses ~15% into the viewport. Once revealed it stays revealed —
    // the observer unobserves to avoid re-firing on scroll-out/in. Users
    // who prefer reduced motion get everything visible immediately (the
    // CSS rule already handles the static state; we just skip the observer).
    const revealNodes = document.querySelectorAll('.reveal');
    if (revealNodes.length > 0) {
      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (prefersReducedMotion || typeof IntersectionObserver === 'undefined') {
        revealNodes.forEach((el) => el.classList.add('is-visible'));
      } else {
        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            }
          },
          { threshold: 0.15, rootMargin: '0px 0px -8% 0px' },
        );
        revealNodes.forEach((el) => observer.observe(el));
      }
    }

    // Testimonial carousel — rotates the three .why-card slides on a
    // ms interval set via `data-rotate-interval` on the carousel root
    // (defaults to 8s). Pauses while the pointer is over the carousel
    // or while keyboard focus is inside it, so reading a long quote
    // doesn't get cut short. Clicking a dot jumps to that slide and
    // resets the interval. Respects prefers-reduced-motion: no
    // auto-rotation, but dots still work for manual navigation.
    const carousel = document.querySelector<HTMLElement>('.why-carousel');
    if (carousel) {
      const slides = Array.from(carousel.querySelectorAll<HTMLElement>('.why-card'));
      const dots = Array.from(carousel.querySelectorAll<HTMLButtonElement>('.dot'));
      const interval = Number(carousel.dataset.rotateInterval ?? '8000');
      let index = 0;
      let timerId: ReturnType<typeof setInterval> | null = null;
      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      const show = (next: number) => {
        slides.forEach((slide, i) => {
          const active = i === next;
          slide.classList.toggle('is-active', active);
          slide.setAttribute('aria-hidden', active ? 'false' : 'true');
        });
        dots.forEach((dot, i) => {
          const active = i === next;
          dot.classList.toggle('is-active', active);
          dot.setAttribute('aria-selected', active ? 'true' : 'false');
        });
        index = next;
      };

      const start = () => {
        if (prefersReducedMotion || slides.length < 2 || timerId !== null) return;
        timerId = setInterval(() => show((index + 1) % slides.length), interval);
      };
      const stop = () => {
        if (timerId !== null) {
          clearInterval(timerId);
          timerId = null;
        }
      };

      dots.forEach((dot, i) => {
        dot.addEventListener('click', () => {
          show(i);
          stop();
          start();
        });
      });

      carousel.addEventListener('pointerenter', stop);
      carousel.addEventListener('pointerleave', start);
      carousel.addEventListener('focusin', stop);
      carousel.addEventListener('focusout', (e) => {
        // Only restart if focus actually left the carousel, not just shifted
        // between dots within it.
        if (!carousel.contains(e.relatedTarget as Node | null)) start();
      });

      start();
    }

    // Progressive enhancement for the contact form.
    //
    // Default (no JS): the <form> posts to /api/contact (our Astro API route),
    // which proxies the submission to Jotform server-side and 303-redirects
    // back to /?contact=ok|err#contact. The user lands at the contact section
    // and the inline status-from-URL handler below shows the success or error
    // banner. Functional even with JS disabled.
    //
    // With JS: intercept submit, POST the form as JSON to /api/contact via
    // fetch(), and inspect the JSON `{ ok: true }` / `{ ok: false }` response.
    // Unlike the old iframe-target flow, we now know with certainty whether
    // Jotform accepted the payload — a 400 from Jotform surfaces as our error
    // banner instead of a false-positive success message.
    const form = document.getElementById('contact-form') as HTMLFormElement | null;
    // Both `success` and `errorBox` are optional — they're only rendered when
    // Tina content supplies the matching copy. Don't gate the form upgrade on
    // them, or an editor blanking successText would break the JS handoff.
    const success = document.getElementById('form-success');
    const errorBox = document.getElementById('form-error');

    // Show success/error from the no-JS redirect path. `?contact=ok` means the
    // server-side proxy reported success; `?contact=err` means it didn't.
    // Strip the query param after applying so a refresh doesn't replay it.
    if (window.location.search.includes('contact=')) {
      const params = new URLSearchParams(window.location.search);
      const status = params.get('contact');
      if (status === 'ok' && success) success.classList.add('visible');
      if (status === 'err' && errorBox) errorBox.hidden = false;
      params.delete('contact');
      const cleanQuery = params.toString();
      const cleanUrl = window.location.pathname + (cleanQuery ? `?${cleanQuery}` : '') + window.location.hash;
      window.history.replaceState({}, '', cleanUrl);
    }

    if (form) {
      form.noValidate = true;

      const SUBMIT_TIMEOUT_MS = 15000;
      const submitBtn = form.querySelector('button[type="submit"]') as HTMLButtonElement | null;

      form.addEventListener('submit', async (e) => {
        if (!form.checkValidity()) {
          e.preventDefault();
          form.reportValidity();
          return;
        }
        e.preventDefault();
        if (success) success.classList.remove('visible');
        if (errorBox) errorBox.hidden = true;
        if (submitBtn) submitBtn.disabled = true;

        // Serialize to a plain object so the proxy can read JSON. Multi-value
        // fields would collapse to the last value here, but our form has none.
        const formData = new FormData(form);
        const payload: Record<string, string> = {};
        for (const [k, v] of formData.entries()) {
          if (typeof v === 'string') payload[k] = v;
        }

        const controller = new AbortController();
        const timeoutId = setTimeout(() => controller.abort(), SUBMIT_TIMEOUT_MS);

        try {
          const response = await fetch('/api/contact', {
            method: 'POST',
            headers: { 'content-type': 'application/json', accept: 'application/json' },
            body: JSON.stringify(payload),
            signal: controller.signal,
          });
          const result = (await response.json().catch(() => ({ ok: false }))) as { ok?: boolean; error?: string };
          if (response.ok && result.ok) {
            if (success) success.classList.add('visible');
            form.reset();
          } else {
            console.error('Contact form: proxy reported failure', response.status, result.error);
            if (errorBox) errorBox.hidden = false;
          }
        } catch (err) {
          console.error('Contact form: request failed', err);
          if (errorBox) errorBox.hidden = false;
        } finally {
          clearTimeout(timeoutId);
          if (submitBtn) submitBtn.disabled = false;
        }
      });
    }
  </script>
</body>
</html>
