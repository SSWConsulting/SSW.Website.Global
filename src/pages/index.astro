---
const title = 'SSW · Enterprise AI-assisted software delivery for the Americas';
const description = 'Ship enterprise-grade software faster with AI-assisted development, Scrum discipline, and a North America-based Scrum Master.';
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="stylesheet" href="/assets/colors_and_type.css" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" integrity="sha512-SnH5WK+bZxgPHs44uWIX+LLJAJ9/2PkPKZ5QiAj6Ta86w+fsb2TkcmfRyVX3pBnMFcV7oQPJkl9QevSCWr3W6A==" crossorigin="anonymous" referrerpolicy="no-referrer" />
  <style is:global>
    *, *::before, *::after { box-sizing: border-box; }
    html { scroll-behavior: smooth; }
    body {
      margin: 0;
      font-size: 16px;
      line-height: 1.6;
      color: var(--text-neutral);
      background: var(--bg-base);
    }
    a { color: inherit; text-decoration: none; }
    img { max-width: 100%; display: block; }
    button { font: inherit; cursor: pointer; }
    ::selection { background: var(--red-100); color: var(--red-900); }

    :root {
      --page-max: 1240px;
      --gutter: clamp(20px, 4vw, 48px);
      --section-pad: clamp(72px, 9vw, 128px);
      --hairline: 1px solid var(--stroke-neutral);
    }

    .container {
      max-width: var(--page-max);
      margin: 0 auto;
      padding-left: var(--gutter);
      padding-right: var(--gutter);
    }

    body, p { font-size: 16px; line-height: 1.6; }
    .eyebrow {
      display: inline-flex;
      align-self: flex-start;
      align-items: center;
      gap: 8px;
      font-family: var(--font-sans);
      font-size: 12px;
      font-weight: 500;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--text-brand);
      padding: 6px 12px;
      border: 1px solid var(--red-200);
      background: var(--bg-brand-soft);
      border-radius: var(--radius-full);
    }
    .eyebrow .dot {
      width: 6px; height: 6px; border-radius: 50%;
      background: var(--red-500);
      box-shadow: 0 0 0 4px rgba(204,65,65,0.18);
    }
    .display {
      font-family: var(--font-display);
      font-weight: 700;
      font-size: clamp(40px, 6vw, 72px);
      line-height: 1.02;
      letter-spacing: -0.025em;
      color: var(--text-neutral-strong);
      margin: 0;
    }
    .display em {
      font-style: normal;
      color: var(--red-500);
    }
    h2.section-title {
      font-family: var(--font-display);
      font-weight: 700;
      font-size: clamp(32px, 4.2vw, 48px);
      line-height: 1.05;
      letter-spacing: -0.02em;
      color: var(--text-neutral-strong);
      margin: 0 0 16px;
      text-wrap: balance;
    }
    h3 { margin: 0; }
    .lead {
      font-size: clamp(18px, 1.6vw, 20px);
      line-height: 1.55;
      color: var(--text-neutral-weak);
      margin: 0;
      max-width: 60ch;
      text-wrap: pretty;
    }
    .section-kicker {
      font-family: var(--font-sans);
      font-size: 12px;
      font-weight: 600;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--red-500);
      margin-bottom: 16px;
    }

    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      font-family: var(--font-sans);
      font-weight: 500;
      font-size: 16px;
      letter-spacing: -0.01em;
      padding: 12px 20px;
      border-radius: var(--radius);
      border: 1px solid transparent;
      transition: background var(--duration-fast) var(--ease-out),
                  color var(--duration-fast) var(--ease-out),
                  border-color var(--duration-fast) var(--ease-out),
                  transform var(--duration-fast) var(--ease-out);
      white-space: nowrap;
    }
    .btn i { font-size: 14px; }
    .btn-primary { background: var(--red-500); color: #fff; }
    .btn-primary:hover { background: var(--red-600); }
    .btn-primary:active { background: var(--red-700); }
    .btn-secondary {
      background: #fff;
      color: var(--text-neutral-strong);
      border-color: var(--stroke-neutral-strong);
    }
    .btn-secondary:hover { background: var(--grey-50); }
    .btn-ghost { color: var(--text-neutral-strong); padding: 10px 14px; }
    .btn-ghost:hover { background: var(--grey-100); }
    .btn-lg { padding: 14px 22px; font-size: 17px; }
    .btn-lg i { font-size: 16px; }

    .nav {
      position: sticky;
      top: 0;
      z-index: 50;
      background: rgba(255,255,255,0.82);
      backdrop-filter: saturate(180%) blur(12px);
      -webkit-backdrop-filter: saturate(180%) blur(12px);
      border-bottom: 1px solid transparent;
      transition: border-color var(--duration-normal) var(--ease-out),
                  background var(--duration-normal) var(--ease-out);
    }
    .nav[data-scrolled="true"] {
      border-bottom-color: var(--stroke-neutral-weak);
      background: rgba(255,255,255,0.92);
    }
    .nav-inner {
      display: flex;
      align-items: center;
      justify-content: space-between;
      height: 88px;
      gap: 24px;
    }
    .nav-logo { display: flex; align-items: center; gap: 14px; flex-shrink: 0; }
    .nav-logo img { height: 42px; width: auto; }
    .nav-logo .region {
      white-space: nowrap;
      font-size: 11px;
      font-weight: 600;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--text-neutral-weak);
    }
    .nav-links { display: flex; align-items: center; gap: 0; }
    .nav-item { position: relative; }
    .nav-item > a {
      position: relative;
      padding: 10px 18px;
      font-size: 16px;
      font-weight: 500;
      color: var(--text-neutral);
      letter-spacing: -0.005em;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      transition: color var(--duration-fast) var(--ease-out);
    }
    .nav-item > a::after {
      content: "";
      position: absolute;
      left: 18px; right: 18px;
      bottom: 4px;
      height: 1px;
      background: var(--red-500);
      transform: scaleX(0);
      transform-origin: left;
      transition: transform var(--duration-normal) var(--ease-out);
    }
    .nav-item:hover > a { color: var(--text-neutral-strong); }
    .nav-item:hover > a::after { transform: scaleX(1); }
    .nav-item .caret { font-size: 9px; opacity: 0.5; transition: transform var(--duration-fast) var(--ease-out); }
    .nav-item:hover .caret { transform: rotate(180deg); opacity: 0.9; }

    .nav-dropdown {
      position: absolute;
      top: calc(100% + 4px);
      left: 50%;
      transform: translateX(-50%) translateY(-4px);
      width: 620px;
      background: #fff;
      border: 1px solid var(--stroke-neutral);
      border-radius: var(--radius-xl);
      box-shadow: var(--shadow-overlay);
      padding: 12px;
      opacity: 0;
      pointer-events: none;
      transition: opacity var(--duration-normal) var(--ease-out),
                  transform var(--duration-normal) var(--ease-out);
      z-index: 60;
    }
    .nav-item:hover .nav-dropdown,
    .nav-item:focus-within .nav-dropdown {
      opacity: 1;
      pointer-events: auto;
      transform: translateX(-50%) translateY(0);
    }
    .nav-dropdown ul {
      list-style: none;
      margin: 0; padding: 0;
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 2px;
    }
    .nav-dropdown li a {
      display: flex;
      gap: 12px;
      padding: 12px;
      border-radius: var(--radius);
      align-items: flex-start;
      transition: background var(--duration-fast) var(--ease-out);
    }
    .nav-dropdown li a:hover { background: var(--grey-50); }
    .nav-dropdown li a .ico {
      width: 32px; height: 32px;
      border-radius: var(--radius-sm);
      background: var(--bg-brand-soft);
      color: var(--red-600);
      display: grid; place-items: center;
      flex-shrink: 0;
    }
    .nav-dropdown li a .ico i { font-size: 13px; }
    .nav-dropdown li a strong {
      display: block;
      font-size: 16px;
      font-weight: 600;
      color: var(--text-neutral-strong);
      margin-bottom: 4px;
    }
    .nav-dropdown li a span {
      font-size: 14px;
      color: var(--text-neutral-weak);
      line-height: 1.4;
    }
    .nav-cta { display: flex; align-items: center; gap: 8px; }
    @media (max-width: 980px) {
      .nav-links { display: none; }
      .nav-inner { height: 76px; }
      .nav-logo img { height: 36px; }
    }

    .hero {
      position: relative;
      padding: clamp(72px, 10vw, 128px) 0 clamp(64px, 8vw, 96px);
      overflow: hidden;
    }
    .hero::before {
      content: "";
      position: absolute;
      inset: -200px -200px auto auto;
      width: 900px; height: 900px;
      background: radial-gradient(closest-side, rgba(204,65,65,0.07), transparent 70%);
      pointer-events: none;
      z-index: 0;
    }
    .hero-grid {
      position: relative;
      z-index: 1;
      display: grid;
      grid-template-columns: 1.05fr 0.95fr;
      gap: clamp(40px, 6vw, 80px);
      align-items: center;
    }
    @media (max-width: 980px) { .hero-grid { grid-template-columns: 1fr; } }
    .hero-copy { display: flex; flex-direction: column; gap: 28px; }
    .hero-copy p.lead { font-size: clamp(18px, 1.7vw, 21px); }
    .hero-ctas { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 4px; }
    .hero-meta { display: flex; flex-wrap: wrap; gap: 14px 28px; margin-top: 16px; }
    .hero-meta .item { display: flex; align-items: center; gap: 10px; font-size: 16px; font-weight: 500; color: var(--text-neutral); }
    .hero-meta .check-pill {
      width: 22px; height: 22px;
      border-radius: 50%;
      background: var(--red-50);
      color: var(--red-600);
      display: grid; place-items: center;
      font-size: 11px;
      flex-shrink: 0;
    }

    .hero-visual { position: relative; aspect-ratio: 5 / 4; min-height: 380px; }
    .panel {
      background: #fff;
      border: 1px solid var(--stroke-neutral);
      border-radius: var(--radius-xl);
      box-shadow: var(--shadow-raised);
      padding: 20px;
    }
    .panel-back {
      position: absolute;
      inset: 8% 0 28% 16%;
      background: var(--grey-50);
      border-color: var(--stroke-neutral-weak);
      box-shadow: var(--shadow-xs);
    }
    .panel-back .grid-lines {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 12px;
      height: 100%;
    }
    .panel-back .col {
      background: #fff;
      border: 1px solid var(--stroke-neutral-weak);
      border-radius: var(--radius-md);
      padding: 12px;
      display: flex; flex-direction: column; gap: 8px;
    }
    .panel-back .col h6 {
      margin: 0;
      font-size: 10px;
      font-weight: 600;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--text-neutral-weak);
    }
    .ticket {
      background: var(--grey-50);
      border: 1px solid var(--stroke-neutral-weak);
      border-radius: var(--radius-sm);
      padding: 8px;
      font-size: 11px;
      line-height: 1.4;
      color: var(--text-neutral);
    }
    .ticket .tag {
      display: inline-block;
      font-size: 9px;
      font-weight: 600;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      padding: 2px 6px;
      border-radius: var(--radius-sm);
      margin-bottom: 6px;
    }
    .tag.red { background: var(--red-50); color: var(--red-700); }
    .tag.blue { background: var(--blue-100); color: var(--blue-700); }
    .tag.green { background: var(--green-100); color: var(--green-700); }
    .tag.amber { background: var(--amber-100); color: var(--amber-600); }

    .panel-front { position: absolute; inset: auto 8% 4% 4%; width: 70%; padding: 18px; }
    .panel-front .head { display: flex; align-items: center; gap: 10px; margin-bottom: 14px; }
    .panel-front .head .dots { display: flex; gap: 6px; }
    .panel-front .head .dots span { width: 9px; height: 9px; border-radius: 50%; background: var(--grey-200); }
    .panel-front .head h4 {
      font-size: 12px; font-weight: 600;
      color: var(--text-neutral-weak);
      margin: 0;
      letter-spacing: 0.04em;
    }
    .code-line {
      font-family: var(--font-mono);
      font-size: 12px;
      line-height: 1.7;
      color: var(--text-neutral);
      white-space: pre;
      overflow: hidden;
    }
    .code-line .kw { color: var(--red-600); }
    .code-line .fn { color: var(--blue-600); }
    .code-line .str { color: var(--green-700); }
    .code-line .cm { color: var(--text-neutral-weaker); }

    .ai-suggest {
      margin-top: 14px;
      padding: 10px 12px;
      background: var(--bg-brand-soft);
      border: 1px solid var(--red-100);
      border-radius: var(--radius-md);
      display: flex; gap: 10px; align-items: flex-start;
      font-size: 12px; color: var(--red-800);
    }
    .ai-suggest i { color: var(--red-500); flex-shrink: 0; margin-top: 2px; }
    .ai-suggest strong { color: var(--red-900); }

    .stats {
      background: #fff;
      border-top: 1px solid var(--stroke-neutral-weak);
      border-bottom: 1px solid var(--stroke-neutral-weak);
    }
    .stats-grid { display: grid; grid-template-columns: repeat(4, 1fr); }
    @media (max-width: 760px) { .stats-grid { grid-template-columns: repeat(2, 1fr); } }
    .stat { padding: 32px 24px; border-right: 1px solid var(--stroke-neutral-weak); }
    .stat:last-child { border-right: none; }
    @media (max-width: 760px) {
      .stat:nth-child(2) { border-right: none; }
      .stat:nth-child(1), .stat:nth-child(2) { border-bottom: 1px solid var(--stroke-neutral-weak); }
    }
    .stat .num {
      font-family: var(--font-display);
      font-size: clamp(32px, 3.6vw, 42px);
      font-weight: 700;
      letter-spacing: -0.025em;
      line-height: 1;
      color: var(--text-neutral-strong);
    }
    .stat .num em { font-style: normal; color: var(--red-500); }
    .stat .label { margin-top: 8px; font-size: 16px; color: var(--text-neutral-weak); line-height: 1.45; }

    section.block { padding: var(--section-pad) 0; }
    section.block.sunken { background: var(--grey-50); }
    .block-head { max-width: 720px; margin-bottom: clamp(48px, 6vw, 72px); }

    .benefits-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 1px;
      background: var(--stroke-neutral-weak);
      border: 1px solid var(--stroke-neutral-weak);
      border-radius: var(--radius-xl);
      overflow: hidden;
    }
    @media (max-width: 920px) { .benefits-grid { grid-template-columns: repeat(2, 1fr); } }
    @media (max-width: 560px) { .benefits-grid { grid-template-columns: 1fr; } }
    .benefit { background: #fff; padding: 32px 28px; display: flex; flex-direction: column; gap: 12px; }
    .benefit .icon {
      width: 40px; height: 40px;
      border-radius: var(--radius-md);
      background: var(--bg-brand-soft);
      color: var(--red-600);
      display: grid; place-items: center;
      margin-bottom: 8px;
    }
    .benefit .icon i { font-size: 18px; }
    .benefit h3 { font-size: 18px; font-weight: 600; letter-spacing: -0.015em; color: var(--text-neutral-strong); }
    .benefit p { font-size: 16px; color: var(--text-neutral-weak); line-height: 1.55; margin: 0; }

    .services-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 16px; }
    @media (max-width: 760px) { .services-grid { grid-template-columns: 1fr; } }
    .service {
      background: #fff;
      border: 1px solid var(--stroke-neutral);
      border-radius: var(--radius-xl);
      padding: 28px;
      display: flex;
      gap: 20px;
      align-items: flex-start;
      transition: border-color var(--duration-normal) var(--ease-out),
                  box-shadow var(--duration-normal) var(--ease-out),
                  transform var(--duration-normal) var(--ease-out);
    }
    .service:hover { border-color: var(--red-200); box-shadow: var(--shadow-raised); }
    .service .icon {
      width: 44px; height: 44px;
      flex-shrink: 0;
      border-radius: var(--radius-md);
      background: var(--bg-brand-soft);
      color: var(--red-600);
      display: grid; place-items: center;
    }
    .service .icon i { font-size: 18px; }
    .service .body { display: flex; flex-direction: column; gap: 6px; }
    .service h3 { font-size: 17px; font-weight: 600; letter-spacing: -0.015em; color: var(--text-neutral-strong); }
    .service p { font-size: 16px; color: var(--text-neutral-weak); line-height: 1.55; margin: 0; }

    .steps {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 40px;
      position: relative;
    }
    .steps::before {
      content: "";
      position: absolute;
      top: 32px; left: 32px; right: 32px;
      height: 1px;
      border-top: 1px dashed var(--stroke-neutral);
      z-index: 0;
    }
    @media (max-width: 920px) {
      .steps { grid-template-columns: repeat(2, 1fr); gap: 48px 32px; }
      .steps::before { display: none; }
    }
    @media (max-width: 540px) { .steps { grid-template-columns: 1fr; } }
    .step { position: relative; z-index: 1; background: transparent; border: 0; padding: 0; }
    .step .icon {
      position: relative;
      width: 64px; height: 64px;
      border-radius: 50%;
      background: var(--bg-brand-soft);
      color: var(--red-600);
      display: grid; place-items: center;
      margin-bottom: 24px;
      box-shadow: 0 0 0 8px var(--bg-base);
    }
    .step .icon i { font-size: 22px; }
    .step .step-num {
      font-family: var(--font-mono);
      font-size: 12px;
      font-weight: 600;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--red-500);
      margin-bottom: 8px;
    }
    .step h3 {
      font-family: var(--font-display);
      font-size: 22px;
      font-weight: 700;
      letter-spacing: -0.02em;
      line-height: 1.2;
      color: var(--text-neutral-strong);
      margin: 0 0 12px;
    }
    .step p { font-size: 16px; color: var(--text-neutral-weak); line-height: 1.55; margin: 0; max-width: 32ch; }

    .why-grid { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(48px, 6vw, 88px); align-items: center; }
    @media (max-width: 880px) { .why-grid { grid-template-columns: 1fr; } }
    .why-list { display: flex; flex-direction: column; border-top: 1px solid var(--stroke-neutral-weak); }
    .why-row {
      display: grid;
      grid-template-columns: 44px 1fr;
      gap: 18px;
      padding: 22px 0;
      border-bottom: 1px solid var(--stroke-neutral-weak);
      align-items: flex-start;
    }
    .why-row .badge-ico {
      width: 36px; height: 36px;
      border-radius: var(--radius-md);
      background: var(--bg-brand-soft);
      color: var(--red-600);
      display: grid; place-items: center;
      margin-top: 2px;
    }
    .why-row .badge-ico i { font-size: 15px; }
    .why-row h4 { font-size: 17px; font-weight: 600; letter-spacing: -0.015em; color: var(--text-neutral-strong); margin: 0 0 4px; }
    .why-row p { font-size: 16px; color: var(--text-neutral-weak); line-height: 1.55; margin: 0; }
    .why-card {
      background: var(--grey-900);
      color: #fff;
      border-radius: var(--radius-2xl);
      padding: 40px;
      display: flex; flex-direction: column;
      gap: 24px;
      min-height: 440px;
      justify-content: space-between;
    }
    .why-card .quote-mark { font-family: var(--font-display); font-size: 64px; line-height: 0.5; color: var(--red-500); height: 32px; }
    .why-card blockquote {
      margin: 0;
      font-size: 22px;
      font-weight: 500;
      line-height: 1.4;
      letter-spacing: -0.015em;
      color: rgba(255,255,255,0.95);
      text-wrap: pretty;
    }
    .why-card .attr { display: flex; align-items: center; gap: 14px; padding-top: 24px; border-top: 1px solid rgba(255,255,255,0.12); }
    .why-card .avatar {
      width: 44px; height: 44px;
      border-radius: 50%;
      background: linear-gradient(135deg, var(--red-400), var(--red-700));
      display: grid; place-items: center;
      font-weight: 600;
      font-size: 15px;
      color: #fff;
    }
    .why-card .name { font-weight: 600; color: #fff; font-size: 16px; }
    .why-card .role { font-size: 14px; color: rgba(255,255,255,0.55); }

    .contact-grid {
      display: grid;
      grid-template-columns: 1.25fr 0.9fr;
      gap: clamp(40px, 5vw, 64px);
      align-items: start;
    }
    @media (max-width: 920px) { .contact-grid { grid-template-columns: 1fr; } }

    .form-card {
      background: #fff;
      border: 1px solid var(--stroke-neutral);
      border-top: 4px solid var(--red-500);
      border-radius: var(--radius-2xl);
      padding: clamp(32px, 4vw, 48px);
      box-shadow: var(--shadow-overlay);
      position: relative;
    }
    .form-card::before {
      content: "";
      position: absolute;
      inset: -2px;
      border-radius: var(--radius-2xl);
      background: linear-gradient(180deg, rgba(204,65,65,0.18), transparent 30%);
      z-index: -1;
      pointer-events: none;
    }
    .form-card .form-header { margin-bottom: 24px; padding-bottom: 20px; border-bottom: 1px solid var(--stroke-neutral-weak); }
    .form-card .form-header h3 {
      font-family: var(--font-display);
      font-size: 22px;
      font-weight: 700;
      letter-spacing: -0.02em;
      color: var(--text-neutral-strong);
      margin: 0 0 6px;
    }
