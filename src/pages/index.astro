---
import '../styles/landing.css';
import { ClientRouter } from 'astro:transitions';
import TinaIsland from '@tinacms/astro/TinaIsland.astro';
import LandingBody from '../components/islands/LandingBody.astro';
import { getLanding } from '../lib/data';
import { islands } from '../lib/islands';

const slug = 'home';
const result = await getLanding(slug);
const data = result.data?.landing;
if (!data) return new Response('Not Found', { status: 404 });
const meta = data.meta;
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{meta?.title ?? 'SSW'}</title>
  <meta name="description" content={meta?.description ?? ''} />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
  <link rel="icon" type="image/png" href="/favicon-32x32.png" sizes="32x32" />
  <link rel="icon" type="image/png" href="/favicon-16x16.png" sizes="16x16" />
  <link rel="mask-icon" href="/safari-pinned-tab.svg" color="#cc4141" />
  <link rel="shortcut icon" href="/favicon.ico" />
  <link rel="stylesheet" href="/assets/colors_and_type.css" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" integrity="sha512-SnH5WK+bZxgPHs44uWIX+LLJAJ9/2PkPKZ5QiAj6Ta86w+fsb2TkcmfRyVX3pBnMFcV7oQPJkl9QevSCWr3W6A==" crossorigin="anonymous" referrerpolicy="no-referrer" />
  <ClientRouter />
</head>
<body>
  <TinaIsland name="landing" wrapper={islands.landing.wrapper} params={{ slug }} primary>
    <LandingBody data={data} />
  </TinaIsland>

  <script>
    const nav = document.getElementById('nav');
    const onScroll = () => { if (nav) (nav as HTMLElement).dataset.scrolled = window.scrollY > 12 ? 'true' : 'false'; };
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();

    // Progressive enhancement for the Jotform contact form.
    //
    // Default (no JS): the <form> in the HTML is a plain action+method=POST,
    // so the browser handles native validation, posts directly to Jotform,
    // and the user lands on Jotform's hosted thank-you page. Functional but
    // visually inconsistent.
    //
    // With JS: retarget submissions into the hidden iframe (so the user stays
    // on our page) and add novalidate (so our handler owns error display).
    // The iframe's `load` event after a submit means Jotform has rendered its
    // thank-you page inside it -- we treat that as success.
    const form = document.getElementById('contact-form') as HTMLFormElement | null;
    const success = document.getElementById('form-success');
    const errorBox = document.getElementById('form-error');
    const receiver = document.getElementById('jotform-receiver') as HTMLIFrameElement | null;
    if (form && success && receiver) {
      form.target = 'jotform-receiver';
      form.noValidate = true;

      let pendingSubmission = false;
      const submitBtn = form.querySelector('button[type="submit"]') as HTMLButtonElement | null;

      form.addEventListener('submit', (e) => {
        if (!form.checkValidity()) {
          e.preventDefault();
          form.reportValidity();
          return;
        }
        if (!form.getAttribute('action')) {
          e.preventDefault();
          console.error('Contact form: no action set (missing jotformId)');
          if (errorBox) errorBox.hidden = false;
          return;
        }
        success.classList.remove('visible');
        if (errorBox) errorBox.hidden = true;
        if (submitBtn) submitBtn.disabled = true;
        pendingSubmission = true;
      });

      receiver.addEventListener('load', () => {
        if (!pendingSubmission) return; // ignore the initial blank load
        pendingSubmission = false;
        success.classList.add('visible');
        form.reset();
        if (submitBtn) submitBtn.disabled = false;
      });
    }
  </script>
</body>
</html>
